{
  "name": "terraform-module-registry",
  "version": "1.0.0",
  "private": true,
  "description": "Private library of hardened, reusable Terraform modules with secure defaults.",
  "license": "MIT",
  "author": "Project Maintainers",
  "repository": {
    "type": "git",
    "url": "https://github.com/shivajichaprana/terraform-module-registry.git"
  },
  "scripts": {
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD",
