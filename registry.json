      "outputs": {
        "count": 6
      },
      "examples": [
        "basic",
        "complete"
      ],
      "status": "stable",
      "content_hash": "sha256:ac83263ba6e16edbe4c2628eecbb6cdfc19d7ddb26147e1f0fcbb7b254a3918b"
    },
    {
